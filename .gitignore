# Local configuration. Contains your hostnames, project keys, and field names.
config.yml
config.yaml
config.local.*

# A real corpus, and anything a sweep writes. The flat docs/*.md pages are
# this library's own documentation and are tracked by name. Nested files
# under docs/ stay ignored, so an export dropped in a subdirectory is not
# committed. check.py scans those flat pages and skips corpus/ and reports/.
corpus/
docs/*
!docs/approach.md
!docs/background.md
!docs/install.md
!docs/limits.md
!docs/proof.md
!docs/using.md
reports/
*.export.json
*_export.json
index_status.json

# Credentials. Nothing in this repo should ever reference one of these by path,
# but ignore them so an accidental local file cannot be committed.
.env
.env.*
*.pem
*.key
*credentials*
*secret*
*token*

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Python, in case you add tooling alongside
__pycache__/
*.py[cod]
.venv/
venv/
